# ============================================
# VARIABLES DE ENTORNO - CLIENTE MQTT
# Universidad Militar Nueva Granada
# ============================================

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL
# ============================================
# Usar las credenciales proporcionadas por el usuario
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SensoresMQTT
DB_USER=postgres
DB_PASSWORD=2324Julibolt

# ============================================
# CONFIGURACIÓN DEL SERVIDOR MQTT
# ============================================
# IP del servidor donde está ejecutándose el broker MQTT
# Cambiar por la IP real del servidor
MQTT_BROKER=192.168.1.100
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ============================================
# CONFIGURACIÓN DEL CLIENTE
# ============================================
# Identificador único del cliente
CLIENT_ID=cliente_admin_umng

# ============================================
# CONFIGURACIÓN DE LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/cliente_mqtt.log

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Copiar este archivo como .env en la raíz del proyecto
# 2. Cambiar MQTT_BROKER por la IP real del servidor
# 3. Verificar que PostgreSQL esté instalado y funcionando
# 4. Las credenciales DB son las proporcionadas por el usuario